config_version=5

[application]

config/name="Ladder Monkey — 树冠顽猴"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=960
window/size/viewport_height=720
window/size/window_width_override=960
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.17, 0.25, 0.25, 1)

[input]
climb_up={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":87)]}
climb_down={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":83)]}
taunt={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":32)]}

[layer_names]
3d_physics/layer_4="DebrisScenery"
3d_physics/layer_5="GoldFragments"
3d_physics/layer_6="MonkeyRewardProbe"
3d_physics/layer_7="TrophyPickup"
